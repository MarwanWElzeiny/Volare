# Local server
PORT=3000
NODE_ENV=development

# Required for production security.
# Replace both values with separate, long, random secrets.
VOLARE_SECURITY_SECRET=replace-with-a-long-random-secret
VOLARE_LICENSE_SECRET=replace-with-a-different-long-random-secret

# Comma-separated list of permitted browser origins.
VOLARE_ALLOWED_ORIGINS=http://localhost:3000

# Optional Cloudflare Turnstile secret.
TURNSTILE_SECRET_KEY=
