{
  "name": "volare",
  "version": "0.1.0-beta.0",
  "description": "Volare — a premium 3D model viewer built on Three.js. Supports GLB/glTF/FBX/OBJ, plugin architecture, and customizable UI. No server required.",
  "main": "SDK/Core/createVolareViewer.js",
  "module": "SDK/Core/createVolareViewer.js",
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "sideEffects": false,
  "exports": {
    ".": "./SDK/Core/createVolareViewer.js",
    "./core": "./SDK/Core/createVolareViewer.js",
    "./viewer": "./SDK/Core/VolareViewer.js",
    "./security/*": "./SDK/Security/*.js",
    "./managers/*": "./SDK/Managers/*.js",
    "./ui": "./SDK/UI/ViewerUIController.js",
    "./ui/*": "./SDK/UI/*.js",
    "./utils/*": "./SDK/Utils/*.js",
    "./styles/core.css": "./SDK/css/core-tokens.css",
    "./styles/volare.css": "./SDK/css/volare.css"
  },
  "files": [
    "SDK/",
    "DEMO/",
    "examples/",
    "docs/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "validate": "node tools/validate-volare.mjs",
    "security:audit": "node tools/security-audit.mjs",
    "test:security": "node tests/security.test.cjs",
    "test": "npm run test:security && node tests/lifecycle-callbacks.test.mjs",
    "start": "node server/app.js"
  },
  "keywords": [
    "3d-viewer",
    "threejs",
    "gltf",
    "glb",
    "fbx",
    "obj",
    "webgl",
    "model-viewer",
    "sdk",
    "3d",
    "viewer"
  ],
  "author": "Marwan W. Elzeiny <marwan.waleed.yousry@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2"
  }
}
